# Server Port
PORT=3000

# SMTP Email Configuration (e.g. Titan Mail, Google Workspace, AWS SES, Resend)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@example.com
SMTP_PASS=your-smtp-password-here
SMTP_FROM="Leatherbound Vault" <support@example.com>
SMTP_REPLY_TO=support@example.com

# OTP Security & Expiration Settings (optional overrides)
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
